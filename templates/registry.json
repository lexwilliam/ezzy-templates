{
  "templates": {
    "ezzy-template": {
      "name": "Blog Page",
      "description": "A React component to display blogs from internal",
      "version": "1.0.0",
      "files": [
        {
          "path": "components/ezzy-template.tsx",
          "content": "component.tsx"
        },
        {
          "path": "components/ezzy-template.css",
          "content": "styles.css",
          "optional": true
        }
      ],
      "dependencies": [],
      "devDependencies": [],
      "envVars": [
        {
          "name": "INTERNAL_BLOG_API_KEY",
          "description": "Your internal API key",
          "required": false
        },
        {
          "name": "INTERNAL_BLOG_API_BASE_URL",
          "description": "Base URL of your internal instance",
          "required": false
        }
      ]
    }
  }
}
